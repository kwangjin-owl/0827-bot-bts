# ================================================================
#  저장소에 올리지 않는 것
# ================================================================

# 열쇠 ---------------------------------------------------------
#  .env        진짜 값이 있는 파일. 절대 커밋하지 않습니다.
#  config.js   make_config.py 가 .env 에서 만들어 냅니다. 값이 들어 있습니다.
.env
.env.local
.env.*.local
config.js

# 파이썬 상자 --------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]

# 실습 데이터 --------------------------------------------------
#  wos_*.jsonl / wos_*.md 는 다 합쳐 140MB 가 넘습니다.
#  GitHub 은 50MB 넘는 파일에 경고를 띄우고 100MB 부터는 거부합니다.
#  저장소에 넣고 싶으면 아래 줄을 지우고 Git LFS 를 쓰세요.
data/
*.jsonl

# 압축 파일 ----------------------------------------------------
*.zip

# 편집기 / 운영체제 --------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 기타 ---------------------------------------------------------
*.log
.gradio/
